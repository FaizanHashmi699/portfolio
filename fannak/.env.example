# ---------------------------------------------------------------------------
# Fannak — environment
# Every value lives here, never only in a vendor dashboard (Step 2 §6.2 rule 4).
# The app runs without any of these: the data layer falls back to seed data.
# ---------------------------------------------------------------------------

# Supabase (Data & auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Channel)
# Works unverified at 250 business-initiated conversations / 24h.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NEW_LEAD=fannak_new_lead

# Wathq (Compliance — CR verification). Free basic package.
WATHQ_API_KEY=

# Public site URL, used for absolute links in outbound messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
