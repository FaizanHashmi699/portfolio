# Supabase — safe to expose, protected by row-level security
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Stripe — leave unset to run the donation flow in pledge mode (no card taken).
# Set both to switch the donate page into live payment collection.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
